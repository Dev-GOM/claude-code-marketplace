{
  "name": "browser-pilot-cli",
  "version": "1.0.0",
  "description": "Chrome DevTools Protocol browser automation CLI",
  "main": "dist/cli.js",
  "bin": {
    "cdp-browser": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
