    "bp:navigate": "node dist/cli.js navigate",
    "bp:extract": "node dist/cli.js extract",
    "bp:click": "node dist/cli.js click",
    "bp:fill": "node dist/cli.js fill",
    "bp:eval": "node dist/cli.js eval",
    "bp:pdf": "node dist/cli.js pdf",
    "bp:cookies": "node dist/cli.js cookies",
    "bp:tabs": "node dist/cli.js tabs",
    "bp:new-tab": "node dist/cli.js new-tab",
    "bp:close-tab": "node dist/cli.js close-tab",
    "bp:close": "node dist/cli.js close",
    "bp:hover": "node dist/cli.js hover",
    "bp:press": "node dist/cli.js press",
    "bp:type": "node dist/cli.js type",
    "bp:upload": "node dist/cli.js upload",
    "bp:reload": "node dist/cli.js reload",
    "bp:back": "node dist/cli.js back",
    "bp:forward": "node dist/cli.js forward",
