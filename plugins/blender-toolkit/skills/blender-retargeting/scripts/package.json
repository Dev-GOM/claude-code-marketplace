{
  "name": "blender-toolkit-cli",
  "version": "1.3.0",
  "description": "Blender automation CLI with geometry, materials, modifiers, collections, animation retargeting, and WebSocket-based control",
  "main": "dist/index.js",
  "bin": {
    "blender-toolkit": "./dist/cli/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "bt:create-cube": "node dist/cli/cli.js create-cube",
    "bt:create-sphere": "node dist/cli/cli.js create-sphere",
    "bt:create-cylinder": "node dist/cli/cli.js create-cylinder",
    "bt:create-plane": "node dist/cli/cli.js create-plane",
    "bt:list-objects": "node dist/cli/cli.js list-objects",
    "bt:transform": "node dist/cli/cli.js transform",
    "bt:delete": "node dist/cli/cli.js delete",
    "bt:retarget": "node dist/cli/cli.js retarget"
  },
  "keywords": [
    "blender",
    "animation",
    "retargeting",
    "mixamo",
    "websocket",
    "geometry",
    "materials",
    "modifiers",
    "collections",
    "3d",
    "automation"
  ],
  "author": "Dev GOM",
  "license": "Apache-2.0",
  "dependencies": {
    "commander": "^14.0.2",
    "ws": "^8.14.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.0.0"
  }
}
